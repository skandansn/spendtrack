# Plaid dashboard -> Developers -> Keys.
# client_id is shared across environments; the SECRET IS PER-ENVIRONMENT.
# Keep both here and switch environments by editing PLAID_ENV alone.
PLAID_CLIENT_ID=
PLAID_SECRET_SANDBOX=
PLAID_SECRET_PRODUCTION=

# sandbox = free, unlimited fake banks, costs no Items.
# production = real banks; each linked institution permanently consumes one of
# the 10 free Trial Items, and deleting it does NOT give the slot back.
PLAID_ENV=sandbox

# What categorises merchants no rule matches:
#   llm  : a chat model at LLM_BASE_URL (below)
#   laya : the Laya decision model at LAYA_BASE_URL (needs ~/llm/laya/start-laya.cmd running)
#   none : no model at all; unmatched merchants fall back to Plaid's category
CATEGORIZER=llm

# Laya answers with a calibrated confidence. Below this the merchant is left
# uncategorised for review rather than cached under a guess.
LAYA_BASE_URL=http://127.0.0.1:8090
LAYA_MIN_CONFIDENCE=0.7

# Any OpenAI-compatible endpoint. Only merchants no rule matches are sent here,
# and each distinct merchant is asked about exactly once, ever.
#   Ollama  : http://127.0.0.1:11434/v1  (loads on demand - good for unattended sync)
#   Bonsai 2: http://127.0.0.1:8080/v1   (needs llm/bonsai/start-bonsai.cmd running)
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=huihui_ai/qwen3.5-abliterated:9b
